from collections.abc import AsyncIterable, AsyncIterator, Awaitable, Callable, Iterable, Mapping, Set
from typing import Any, TypeAlias, TypeVar, overload
from re import Pattern

_T = TypeVar('_T')
_R = TypeVar('_R')
_K = TypeVar('_K')
_Seq: TypeAlias = Iterable[_T] | AsyncIterable[_T]
_XFunc: TypeAlias = str | bytes | Pattern[Any] | int | slice | Mapping[Any, Any] | Set[Any] | None
_Pred: TypeAlias = Callable[[_T], Any] | _XFunc

__all__ = ['take', 'drop', 'first', 'second', 'nth', 'last', 'rest', 'ilen', 'map', 'lmap', 'filter', 'lfilter', 'remove', 'lremove', 'keep', 'lkeep', 'concat', 'lconcat', 'cat', 'lcat', 'mapcat', 'lmapcat', 'takewhile', 'dropwhile', 'distinct', 'ldistinct', 'group_by', 'count_by', 'partition', 'lpartition', 'chunks', 'lchunks', 'reductions', 'lreductions']

async def take(n: int, seq: _Seq[_T]) -> list[_T]: ...
